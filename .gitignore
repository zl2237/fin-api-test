# ================= Python =================
# 字节码与缓存
__pycache__/
*.py[cod]
*.cache
.pytest_cache/
# 覆盖率产物
htmlcov/
.coverage*
# 虚拟环境
venv/
.venv/
env/
# 本地 vendor 依赖（APScheduler 等沙箱/离线安装产物）
platform/backend/.vendor/

# ================= 前端 / Node =================
platform/frontend/node_modules/
platform/frontend/dist/
platform/frontend/.vite/
*.tsbuildinfo
.npm-cache/
# OpenAPI 类型生成中间产物（api.gen.ts 由 gen:api 重新生成并提交）
platform/frontend/openapi.json

# ================= 敏感配置（含数据库密码，勿提交）=================
# .env 与 .env.local 任意层级生效；.env.example 示例文件正常入库
.env
.env.local
# 真实环境配置；env_demo.yaml 为示例，正常入库
config/env_test.yaml
config/env_pre.yaml

# ================= 运行产物 =================
logs/
*.log
report/
# 文件中心物理存储（内容寻址落盘，路径可被 .env UPLOAD_ROOT 覆盖）
platform/backend/uploads/
# 数据集迁移前备份（一次性产物）
platform/backend/backup_*.json
# 本地导入接口所需文件
*.har
*.openapi.json
# 浏览器诊断截图产物
screenshots*/

# ================= 开发调试临时文件 =================
# 任意目录下划线开头的调试文件；但以下两类必须入库：
# Python 包标记（app/crud 等新包）与前端测试目录（vitest 约定）
**/_*
!**/__init__.py
!**/__tests__/
!**/__tests__/**
# .tmp_ 前缀：CDP 诊断、临时自测脚本等
.tmp_*

# ================= IDE / 系统文件 =================
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ================= 本地工作区 / 工具链（不入库）=================
learn/
.teach
.deps/
skills-lock.json
.agents
.claude
.trae/
# 待发布 skill 仓库（挪到项目外后可删除此行）
trae-api-test-skills/
