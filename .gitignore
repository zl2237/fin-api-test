# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd
*.cache

# 虚拟环境
venv/
env/
.venv/

# 本地 vendor 依赖（APScheduler 等沙箱/离线安装产物，勿提交）
platform/backend/.vendor/

# 日志 & 报告
logs/
report/
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db

# 敏感信息（环境配置含数据库密码等）
config/env_test.yaml
config/env_pre.yaml
platform/backend/.env
.env
.env.local

# 本地导入接口所需文件
*.har
*.openapi.json

# 前端构建产物与依赖
platform/frontend/node_modules/
platform/frontend/dist/
platform/frontend/.vite/
*.tsbuildinfo

# OpenAPI 类型生成的中间产物（api.gen.ts 由 gen:api 重新生成并提交）
platform/frontend/openapi.json

# Python 测试/覆盖率缓存
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# 任意目录下，以下划线开头的开发调试文件
**/_*
# 但 Python 包标记文件不能被忽略（否则 app/crud 等新包无法提交）
!**/__init__.py

# 临时调试脚本/产物（.tmp_ 前缀：CDP 诊断、临时自测脚本等）
.tmp_*

# 浏览器诊断截图产物
screenshots/
screenshots-v2/

# 本地teach skill学习目录
.teach

# 本地skill
skills-lock.json
.agents
.claude

# 数据集迁移前备份（一次性产物，不入库）
platform/backend/backup_*.json

# 本地学习/文档目录（个人笔记，不入库）
learn/
docs/
