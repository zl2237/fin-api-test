# ================= Python =================
__pycache__/
*.py[cod]
*.cache
.pytest_cache/
venv/
.venv/
# 本地 vendor 依赖（APScheduler 等沙箱/离线安装产物）
platform/backend/.vendor/
# mypy 缓存（pre-commit backend-mypy advisory）
.mypy_cache/

# ================= 前端 / Node =================
platform/frontend/node_modules/
platform/frontend/dist/
platform/frontend/.vite/
# vitest 覆盖率 HTML 报告（npm run test:coverage 产物）
platform/frontend/coverage/
*.tsbuildinfo
# OpenAPI 类型生成中间产物（api.gen.ts 由 gen:api 重新生成并提交）
platform/frontend/openapi.json

# ================= 敏感配置（含数据库密码，勿提交）=================
# .env 与 .env.local 任意层级生效；.env.example 示例文件正常入库
.env
.env.local
# 真实环境配置；env_demo.yaml 为示例，正常入库
config/env_test.yaml
config/env_pre.yaml
# RSA 密钥材料（对接加密传输/验签交付物，仅存本地/平台环境配置，绝不入库）
private_key.pem
public_key.pem

# ================= 运行产物 =================
logs/
*.log
# pytest-html 报告目录（pytest.ini addopts 与 run.py 均写入 report/）
report/
# 文件中心物理存储（内容寻址落盘，路径可被 UPLOAD_ROOT 覆盖）
platform/backend/uploads/
# 库数据备份（scripts 备份/数据修复库行备份，含数据勿提交；任意层级同名目录）
backups/
# 本地导入接口所需文件（HAR 可能含会话凭据）
*.har
*.openapi.json

# ================= 会话临时 / 缓存（2026-11-05 大清扫后防再生）=================
Temp/
.ruff_cache/
# .tmp_ 前缀：CDP 诊断、临时自测脚本等
.tmp_*

# ================= 下划线调试文件约定 =================
# 任意目录下划线开头 = 调试文件不入库；两类例外必须入库：
# Python 包标记（app/crud 等新包）与前端测试目录（vitest 约定）
**/_*
!**/__init__.py
!**/__tests__/
!**/__tests__/**

# ================= IDE / 系统文件 =================
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ================= 本地工作区 / 工具链（不入库）=================
.claude
.trae/
.pw_tmp/
# 架构评审报告本地归档
architecture-reviews/
