# fin-api-test 平台后端环境变量配置示例
# 复制本文件为 .env 并填写真实值，或直接在系统环境变量中设置
#
# Windows (PowerShell) 一次性设置示例：
#   $env:JWT_SECRET_KEY='你的随机密钥'
#   $env:DB_PASSWORD='123456'
#   python -m uvicorn app.main:app --host 0.0.0.0 --port 8000

# JWT 签名密钥（必填）：用于签发和验证登录 token
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=请替换为你的随机密钥

# MySQL 连接配置（DB_PASSWORD 必填）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=fin_api_test
